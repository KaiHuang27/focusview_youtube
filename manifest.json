{
  "manifest_version": 3,
  "name": "FocusView – Zoom, Rotate & Mirror for YouTube",
  "short_name": "FocusView",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.8",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FocusView – Zoom, Rotate & Mirror for YouTube",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/transform-state.js",
        "src/support-prompt.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_start"
    }
  ],
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/support-background.js"
  }
}
